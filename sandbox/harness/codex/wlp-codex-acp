#!/usr/bin/env node
// Fill the gateway header inside the sandbox. Neither side of the ACP link
// needs to read a login file or send the session lease over a control frame.
const { spawn } = require('node:child_process');
const { createInterface } = require('node:readline');
const { once } = require('node:events');
// codex-acp reaches Codex through wlp-codex-app-server, which keeps a repository's .codex/ unloaded.
// wlp-acp-mcp in front of it serves the platform's MCP server (declared "type": "acp") on the one loopback
// URL /etc/codex/requirements.toml allows; codex-acp's own bridge would pick a random port. codex-acp drops
// a requested server that any config layer names, even the repository's .codex/ that Codex does not load:
// DISABLE_MCP_CONFIG_FILTERING keeps the platform's, so a repository cannot take its tools away.
//
// The platform names the turn's model in WLP_CODEX_MODEL. codex-acp resumes a session with the model of Codex's
// config, not the one it was recorded with, and only then takes the platform's model selection: without it in
// CODEX_CONFIG, every resumed turn would start on Codex's default model.
function codexEnv(env) {
  const config = env.CODEX_CONFIG ? JSON.parse(env.CODEX_CONFIG) : {};
  const model = env.WLP_CODEX_MODEL;
  if (model && /^[A-Za-z0-9._:-]{1,128}$/.test(model)) config.model = model;
  const out = { ...env, CODEX_PATH: '/usr/local/bin/wlp-codex-app-server', WLP_ACP_MCP_PORT: '17895', DISABLE_MCP_CONFIG_FILTERING: 'true' };
  delete out.WLP_CODEX_MODEL;
  if (Object.keys(config).length) out.CODEX_CONFIG = JSON.stringify(config);
  return out;
}
if (require.main !== module) module.exports = { codexEnv };
else main();
function main() {
const child = spawn(process.execPath, ['/usr/local/bin/wlp-acp-mcp.mjs', process.execPath, '/opt/wlp-codex/node_modules/@agentclientprotocol/codex-acp/dist/index.js'], {
  stdio: ['pipe', 'inherit', 'inherit'],
  env: codexEnv(process.env),
});
child.on('exit', code => process.exit(code ?? 1));
child.stdin.on('error', () => process.exit(1));
(async () => {
  for await (const line of createInterface({ input: process.stdin, crlfDelay: Infinity })) {
    const msg = JSON.parse(line);
    if (msg.method === 'providers/set') {
      if (!process.env.WLP_SESSION_BEARER) {
        process.stdout.write(JSON.stringify({ jsonrpc:'2.0', id:msg.id, error:{code:-32000,message:'Authentication required'} }) + '\n');
        continue;
      }
      msg.params = { providerId:'openai', apiType:'openai', baseUrl:'http://127.0.0.1:17892/codex/v1',
        headers:{authorization:'Bearer ' + process.env.WLP_SESSION_BEARER} };
    }
    if (!child.stdin.write(JSON.stringify(msg) + '\n')) await once(child.stdin, 'drain');
  }
  child.stdin.end();
})().catch(() => { child.kill(); process.exitCode = 1; });
}
