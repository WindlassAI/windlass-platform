#!/bin/sh
set -eu
export NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}${no_proxy:+,$no_proxy}" no_proxy=
export no_proxy="$NO_PROXY"
export OPENCODE_DISABLE_PROJECT_CONFIG=true OPENCODE_DISABLE_MODELS_FETCH=true OPENCODE_DISABLE_AUTOUPDATE=true
export OPENCODE_PURE=true OPENCODE_DISABLE_EXTERNAL_SKILLS=true OPENCODE_DISABLE_CLAUDE_CODE=true OPENCODE_DISABLE_LSP_DOWNLOAD=true
export XDG_CONFIG_HOME=/etc/wlp-opencode
case "${WLP_OPENCODE_PROVIDER:?}" in
  free) provider=opencode ;;
  chatgpt) provider=openai ;;
  openai|anthropic) provider=$WLP_OPENCODE_PROVIDER ;;
  *) exit 2 ;;
esac
export OPENCODE_CONFIG_CONTENT="{\"enabled_providers\":[\"$provider\"]}"
exec opencode acp --hostname 127.0.0.1 --no-mdns
