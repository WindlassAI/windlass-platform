#!/bin/sh
set -eu
export NO_PROXY="127.0.0.1${NO_PROXY:+,$NO_PROXY}${no_proxy:+,$no_proxy}"
export no_proxy="$NO_PROXY"
export CLAUDE_AGENT_ACP_PROTOCOL=v1 DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# The TodoWrite list, not the task tools: each turn starts a new adapter, which knows only the tasks made
# in its own turn, so a task finished in a later turn never reached the plan. TodoWrite sends the whole list.
export CLAUDE_CODE_ENABLE_TASKS=false
exec /opt/wlp-claude/node_modules/.bin/claude-agent-acp "$@"
