# Optional server env file for Compose. See runner-release.md.
# Deploy the server, publish the runner image, then replace both settings together.
# Use the published registry digest and the matching capabilities command output.
WLP_RUNNER_IMAGE=registry.example.org/windlass/runner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WLP_RUNNER_CAPABILITIES='{"image":"registry.example.org/windlass/runner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","harnesses":["claude","opencode"]}'
